# Neon PostgreSQL Connection URLs (Provided by Neon CLI / Dashboard)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# Optional JWT Secret for session signing
JWT_SECRET=your_jwt_secret_key_for_lifeos
